# ──────────────────────────────────────
# HMS Backend - Test Environment
# Used by: npm test
# ──────────────────────────────────────

NODE_ENV=test
JWT_SECRET=test-jwt-secret-for-testing
JWT_EXPIRATION=15m

# Test database — MUST be separate from development/production
TEST_DATABASE_URL=postgresql://hms:hms_password@localhost:55432/hms_test

AI_SERVICE_URL=http://localhost:8000

# Setup commands:
#   docker exec hms-postgres createdb -U hms hms_test
#   DATABASE_URL=$TEST_DATABASE_URL npx prisma db push --skip-generate
#   npm test
