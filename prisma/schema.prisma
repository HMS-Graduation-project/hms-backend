generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MINISTRY_ADMIN
  REGIONAL_ADMIN
  ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PATIENT
  PHARMACIST
  LAB_TECHNICIAN
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String          @map("password_hash")
  role           Role            @default(PATIENT)
  firstName      String?         @map("first_name")
  lastName       String?         @map("last_name")
  phone          String?
  avatar         String?
  gender         String?
  dateOfBirth    DateTime?       @map("date_of_birth")
  address        String?
  isActive       Boolean         @default(true) @map("is_active")
  hospitalId     String?         @map("hospital_id") // null for SUPER_ADMIN / MINISTRY_ADMIN / REGIONAL_ADMIN
  hospital       Hospital?       @relation(fields: [hospitalId], references: [id])
  // cityId is set for REGIONAL_ADMIN (binds them to a city). Hospital-scoped
  // users inherit cityId from hospital.cityId at token-mint time. MINISTRY_ADMIN
  // / SUPER_ADMIN have cityId null (national scope).
  cityId         String?         @map("city_id")
  city           City?           @relation(fields: [cityId], references: [id])
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  doctorProfile    DoctorProfile?   @relation("DoctorUser")
  patientProfile   PatientProfile?  @relation("PatientUser")
  headOfDepartment Department?      @relation("DepartmentHead")
  labResults       LabResult[]      @relation("LabTechnician")
  dispensings      Dispensing[]     @relation("PharmacistDispensing")
  notifications    Notification[]
  triagedEmergencyVisits EmergencyVisit[] @relation("EmergencyTriagedBy")

  @@index([hospitalId])
  @@map("users")
}

model Department {
  id           String          @id @default(uuid())
  name         String
  description  String?
  floor        String?
  phone        String?
  isActive     Boolean         @default(true) @map("is_active")
  headDoctorId String?         @unique @map("head_doctor_id")
  headDoctor   User?           @relation("DepartmentHead", fields: [headDoctorId], references: [id])
  hospitalId   String          @map("hospital_id")
  hospital     Hospital        @relation(fields: [hospitalId], references: [id])
  doctors      DoctorProfile[] @relation("DepartmentDoctors")
  appointments Appointment[]
  wards        Ward[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([hospitalId, name])
  @@index([hospitalId])
  @@map("departments")
}

model DoctorProfile {
  id              String           @id @default(uuid())
  userId          String           @unique @map("user_id")
  user            User             @relation("DoctorUser", fields: [userId], references: [id])
  specialization  String
  licenseNumber   String           @unique @map("license_number")
  departmentId    String?          @map("department_id")
  department      Department?      @relation("DepartmentDoctors", fields: [departmentId], references: [id])
  bio             String?
  yearsExperience Int?             @map("years_experience")
  consultationFee Decimal?         @map("consultation_fee") @db.Decimal(10, 2)
  isAvailable     Boolean          @default(true) @map("is_available")
  hospitalId      String           @map("hospital_id")
  hospital        Hospital         @relation(fields: [hospitalId], references: [id])
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  schedules          DoctorSchedule[]
  appointments       Appointment[]    @relation("DoctorAppointments")
  medicalRecords     MedicalRecord[]  @relation("DoctorRecords")
  prescriptions      Prescription[]   @relation("DoctorPrescriptions")
  labOrders          LabOrder[]       @relation("DoctorLabOrders")
  emergencyAttendings EmergencyVisit[] @relation("EmergencyAttending")
  admissions          Admission[]      @relation("AdmittingDoctor")
  referralsFrom       Referral[]       @relation("ReferralFromDoctor")
  referralsTo         Referral[]       @relation("ReferralToDoctor")

  @@index([hospitalId])
  @@map("doctor_profiles")
}

model PatientProfile {
  id                       String          @id @default(uuid())
  userId                   String?         @unique @map("user_id") // null if the patient has no login yet (staff-created, no self-service access)
  user                     User?           @relation("PatientUser", fields: [userId], references: [id])
  nationalPatientId        String          @map("national_patient_id")
  nationalPatient          NationalPatient @relation(fields: [nationalPatientId], references: [id])
  bloodType                String?         @map("blood_type")
  allergies                String?
  emergencyContactName     String?         @map("emergency_contact_name")
  emergencyContactPhone    String?         @map("emergency_contact_phone")
  emergencyContactRelation String?         @map("emergency_contact_relation")
  insuranceProvider        String?         @map("insurance_provider")
  insurancePolicyNumber    String?         @map("insurance_policy_number")
  medicalNotes             String?         @map("medical_notes")
  hospitalId               String          @map("hospital_id")
  hospital                 Hospital        @relation(fields: [hospitalId], references: [id])
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  appointments             Appointment[]    @relation("PatientAppointments")
  medicalRecords           MedicalRecord[]  @relation("PatientRecords")
  prescriptions            Prescription[]   @relation("PatientPrescriptions")
  labOrders                LabOrder[]       @relation("PatientLabOrders")
  invoices                 Invoice[]        @relation("PatientInvoices")
  emergencyVisits          EmergencyVisit[] @relation("PatientEmergencyVisits")
  admissions               Admission[]      @relation("PatientAdmissions")

  @@unique([hospitalId, nationalPatientId])
  @@index([hospitalId])
  @@index([nationalPatientId])
  @@map("patient_profiles")
}

// ─── Phase 3: Clinical Workflow ─────────────────────────────────

model DoctorSchedule {
  id           String        @id @default(uuid())
  doctorId     String        @map("doctor_id")
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id])
  dayOfWeek    Int           @map("day_of_week") // 0=Sunday, 6=Saturday
  startTime    String        @map("start_time") // "09:00"
  endTime      String        @map("end_time") // "17:00"
  slotDuration Int           @default(30) @map("slot_duration") // minutes
  isActive     Boolean       @default(true) @map("is_active")
  hospitalId   String        @map("hospital_id")
  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([doctorId, dayOfWeek])
  @@index([hospitalId])
  @@map("doctor_schedules")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id            String            @id @default(uuid())
  patientId     String            @map("patient_id")
  patient       PatientProfile    @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId      String            @map("doctor_id")
  doctor        DoctorProfile     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  departmentId  String?           @map("department_id")
  department    Department?       @relation(fields: [departmentId], references: [id])
  hospitalId    String            @map("hospital_id")
  hospital      Hospital          @relation(fields: [hospitalId], references: [id])
  date          DateTime
  startTime     String            @map("start_time")
  endTime       String            @map("end_time")
  status        AppointmentStatus @default(PENDING)
  type          String? // CONSULTATION, FOLLOW_UP, EMERGENCY
  reason        String?
  notes         String?
  cancelReason  String?           @map("cancel_reason")
  medicalRecord MedicalRecord?
  invoices      Invoice[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([hospitalId])
  @@map("appointments")
}

model MedicalRecord {
  id               String          @id @default(uuid())
  // A MedicalRecord belongs to exactly one of: an Appointment (OPD),
  // an EmergencyVisit (ER), or an Admission (IPD). All three FKs are
  // optional; services enforce "exactly one" at the application layer.
  // NOTE: admissionId is NOT unique — an admission generates many records
  // over the stay (admission note, daily progress notes, discharge summary).
  appointmentId    String?         @unique @map("appointment_id")
  appointment      Appointment?    @relation(fields: [appointmentId], references: [id])
  emergencyVisitId String?         @unique @map("emergency_visit_id")
  emergencyVisit   EmergencyVisit? @relation(fields: [emergencyVisitId], references: [id])
  admissionId      String?         @map("admission_id")
  admission        Admission?      @relation(fields: [admissionId], references: [id])
  patientId        String          @map("patient_id")
  patient          PatientProfile  @relation("PatientRecords", fields: [patientId], references: [id])
  doctorId         String          @map("doctor_id")
  doctor           DoctorProfile   @relation("DoctorRecords", fields: [doctorId], references: [id])
  hospitalId       String          @map("hospital_id")
  hospital         Hospital        @relation(fields: [hospitalId], references: [id])
  chiefComplaint   String?         @map("chief_complaint")
  presentIllness   String?         @map("present_illness")
  examination      String?
  diagnosis        String?
  icdCodes         String?         @map("icd_codes")
  treatmentPlan    String?         @map("treatment_plan")
  notes            String?
  vitalSigns       VitalSigns?
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([hospitalId])
  @@index([admissionId])
  @@map("medical_records")
}

model VitalSigns {
  id                     String        @id @default(uuid())
  medicalRecordId        String        @unique @map("medical_record_id")
  medicalRecord          MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  temperature            Decimal?      @db.Decimal(4, 1)
  bloodPressureSystolic  Int?          @map("bp_systolic")
  bloodPressureDiastolic Int?          @map("bp_diastolic")
  heartRate              Int?          @map("heart_rate")
  respiratoryRate        Int?          @map("respiratory_rate")
  oxygenSaturation       Int?          @map("oxygen_saturation")
  weight                 Decimal?      @db.Decimal(5, 1)
  height                 Decimal?      @db.Decimal(5, 1)
  recordedAt             DateTime      @default(now()) @map("recorded_at")

  @@map("vital_signs")
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  PARTIALLY_DISPENSED
  CANCELLED
}

model Prescription {
  id              String             @id @default(uuid())
  medicalRecordId String             @map("medical_record_id")
  medicalRecord   MedicalRecord      @relation(fields: [medicalRecordId], references: [id])
  patientId       String             @map("patient_id")
  patient         PatientProfile     @relation("PatientPrescriptions", fields: [patientId], references: [id])
  doctorId        String             @map("doctor_id")
  doctor          DoctorProfile      @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  hospitalId      String             @map("hospital_id")
  hospital        Hospital           @relation(fields: [hospitalId], references: [id])
  status          PrescriptionStatus @default(PENDING)
  notes           String?
  items           PrescriptionItem[]
  dispensings     Dispensing[]
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([hospitalId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String       @map("prescription_id")
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicationName String       @map("medication_name")
  dosage         String
  frequency      String
  duration       String
  quantity       Int?
  instructions   String?

  @@map("prescription_items")
}

// ─── Phase 4: Support Services ──────────────────────────────────

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model LabOrder {
  id              String          @id @default(uuid())
  medicalRecordId String?         @map("medical_record_id")
  medicalRecord   MedicalRecord?  @relation(fields: [medicalRecordId], references: [id])
  patientId       String          @map("patient_id")
  patient         PatientProfile  @relation("PatientLabOrders", fields: [patientId], references: [id])
  doctorId        String          @map("doctor_id")
  doctor          DoctorProfile   @relation("DoctorLabOrders", fields: [doctorId], references: [id])
  hospitalId      String          @map("hospital_id")
  hospital        Hospital        @relation(fields: [hospitalId], references: [id])
  testName        String          @map("test_name")
  testCategory    String?         @map("test_category")
  status          LabOrderStatus  @default(ORDERED)
  priority        String          @default("NORMAL") // NORMAL, URGENT, STAT
  notes           String?
  result          LabResult?
  orderedAt       DateTime        @default(now()) @map("ordered_at")
  completedAt     DateTime?       @map("completed_at")

  @@index([hospitalId])
  @@map("lab_orders")
}

model LabResult {
  id           String   @id @default(uuid())
  labOrderId   String   @unique @map("lab_order_id")
  labOrder     LabOrder @relation(fields: [labOrderId], references: [id])
  result       String
  normalRange  String?  @map("normal_range")
  unit         String?
  isAbnormal   Boolean  @default(false) @map("is_abnormal")
  technicianId String?  @map("technician_id")
  technician   User?    @relation("LabTechnician", fields: [technicianId], references: [id])
  notes        String?
  reportedAt   DateTime @default(now()) @map("reported_at")

  @@map("lab_results")
}

model Medication {
  id           String       @id @default(uuid())
  name         String
  genericName  String?      @map("generic_name")
  category     String?
  manufacturer String?
  dosageForm   String?      @map("dosage_form")
  strength     String?
  unit         String?
  price        Decimal      @db.Decimal(10, 2)
  stock        Int          @default(0)
  reorderLevel Int          @default(10) @map("reorder_level")
  expiryDate   DateTime?    @map("expiry_date")
  isActive     Boolean      @default(true) @map("is_active")
  hospitalId   String       @map("hospital_id")
  hospital     Hospital     @relation(fields: [hospitalId], references: [id])
  dispensings  Dispensing[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([hospitalId])
  @@map("medications")
}

model Dispensing {
  id             String       @id @default(uuid())
  prescriptionId String       @map("prescription_id")
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicationId   String       @map("medication_id")
  medication     Medication   @relation(fields: [medicationId], references: [id])
  quantity       Int
  pharmacistId   String       @map("pharmacist_id")
  pharmacist     User         @relation("PharmacistDispensing", fields: [pharmacistId], references: [id])
  hospitalId     String       @map("hospital_id")
  hospital       Hospital     @relation(fields: [hospitalId], references: [id])
  dispensedAt    DateTime     @default(now()) @map("dispensed_at")

  @@index([hospitalId])
  @@map("dispensings")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  INSURANCE
  BANK_TRANSFER
}

model Invoice {
  id            String         @id @default(uuid())
  invoiceNumber String         @map("invoice_number")
  patientId     String         @map("patient_id")
  patient       PatientProfile @relation("PatientInvoices", fields: [patientId], references: [id])
  appointmentId String?        @map("appointment_id")
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  hospitalId    String         @map("hospital_id")
  hospital      Hospital       @relation(fields: [hospitalId], references: [id])
  status        InvoiceStatus  @default(DRAFT)
  subtotal      Decimal        @db.Decimal(10, 2)
  tax           Decimal        @default(0) @db.Decimal(10, 2)
  discount      Decimal        @default(0) @db.Decimal(10, 2)
  total         Decimal        @db.Decimal(10, 2)
  paidAmount    Decimal        @default(0) @map("paid_amount") @db.Decimal(10, 2)
  items         InvoiceItem[]
  payments      Payment[]
  issuedAt      DateTime?      @map("issued_at")
  dueDate       DateTime?      @map("due_date")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([hospitalId, invoiceNumber])
  @@index([hospitalId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  category    String // CONSULTATION, LAB_TEST, MEDICATION, PROCEDURE
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  @@map("invoice_items")
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String        @map("invoice_id")
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?
  paidAt    DateTime      @default(now()) @map("paid_at")

  @@map("payments")
}

// ─── Phase 5: Advanced Features ─────────────────────────────────

model Notification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  hospitalId String?   @map("hospital_id") // null = national / cross-hospital notification
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  type       String // APPOINTMENT_BOOKED, LAB_RESULTS_READY, PRESCRIPTION_READY, etc.
  title      String
  message    String
  data       String? // JSON payload for linking to relevant entity
  isRead     Boolean   @default(false) @map("is_read")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([hospitalId])
  @@map("notifications")
}

model Setting {
  id         String    @id @default(uuid())
  key        String
  value      String
  hospitalId String?   @map("hospital_id") // null = global setting
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, key])
  @@index([hospitalId])
  @@map("settings")
}

model Holiday {
  id         String    @id @default(uuid())
  name       String
  date       DateTime
  hospitalId String?   @map("hospital_id") // null = national holiday
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId])
  @@map("holidays")
}

// ─── Phase 6: Audit ─────────────────────────────────────────────

model AuditLog {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id")
  hospitalId String?   @map("hospital_id") // null = national-scoped action
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  action     String // CREATE, UPDATE, DELETE
  entity     String // User, Appointment, etc.
  entityId   String?   @map("entity_id")
  changes    String? // JSON diff
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([hospitalId])
  @@map("audit_logs")
}

// ─── Phase 3: Emergency Module ──────────────────────────────────

enum TriageLevel {
  RED    // 1 — resuscitation / immediate
  ORANGE // 2 — emergent (<10 min)
  YELLOW // 3 — urgent (<60 min)
  GREEN  // 4 — less urgent (<120 min)
  BLUE   // 5 — non-urgent
}

enum EmergencyVisitStatus {
  ARRIVED        // just walked in, not yet triaged
  IN_TRIAGE      // nurse is assessing
  IN_TREATMENT   // triaged, doctor is/has claimed
  DISCHARGED
  ADMITTED
  TRANSFERRED
  LEFT_WITHOUT_BEING_SEEN
}

model EmergencyVisit {
  id                 String               @id @default(uuid())
  hospitalId         String               @map("hospital_id")
  hospital           Hospital             @relation(fields: [hospitalId], references: [id])
  nationalPatientId  String?              @map("national_patient_id") // null while patient is unidentified
  nationalPatient    NationalPatient?     @relation(fields: [nationalPatientId], references: [id])
  patientProfileId   String?              @map("patient_profile_id") // filled once a local PatientProfile is linked/created
  patientProfile     PatientProfile?      @relation("PatientEmergencyVisits", fields: [patientProfileId], references: [id])
  /// Placeholder name shown in queue until identification (e.g. "Unknown Male ~30y")
  displayName        String               @map("display_name")
  chiefComplaint     String               @map("chief_complaint")
  arrivedAt          DateTime             @default(now()) @map("arrived_at")
  triageLevel        TriageLevel?         @map("triage_level")
  triagedById        String?              @map("triaged_by_id") // User id of the nurse/doctor who triaged
  triagedBy          User?                @relation("EmergencyTriagedBy", fields: [triagedById], references: [id])
  triagedAt          DateTime?            @map("triaged_at")
  triageNotes        String?              @map("triage_notes")
  attendingDoctorId  String?              @map("attending_doctor_id") // DoctorProfile id
  attendingDoctor    DoctorProfile?       @relation("EmergencyAttending", fields: [attendingDoctorId], references: [id])
  claimedAt          DateTime?            @map("claimed_at")
  status             EmergencyVisitStatus @default(ARRIVED)
  dispositionNotes   String?              @map("disposition_notes")
  closedAt           DateTime?            @map("closed_at")
  medicalRecord      MedicalRecord?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([hospitalId, status])
  @@index([hospitalId, arrivedAt])
  @@index([nationalPatientId])
  @@map("emergency_visits")
}

// ─── Phase 2: National Patient Registry ─────────────────────────

model NationalPatient {
  id                String           @id @default(uuid()) // NHID
  syrianNationalId  String?          @unique @map("syrian_national_id")
  firstName         String           @map("first_name")
  lastName          String           @map("last_name")
  firstNameAr       String?          @map("first_name_ar")
  lastNameAr        String?          @map("last_name_ar")
  dateOfBirth       DateTime         @map("date_of_birth")
  gender            String
  bloodType         String?          @map("blood_type")
  allergies         String? // flat text for MVP; structured in later phases
  chronicConditions String?          @map("chronic_conditions")
  criticalAlerts    String?          @map("critical_alerts") // e.g. "Penicillin allergy, Diabetic"
  phone             String?
  address           String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  profiles          PatientProfile[]
  emergencyVisits   EmergencyVisit[]
  referrals         Referral[]

  @@index([syrianNationalId])
  @@index([lastName, firstName, dateOfBirth])
  @@map("national_patients")
}

// ─── Phase 1: Multi-Tenancy Foundation ──────────────────────────

model City {
  id          String     @id @default(uuid())
  name        String     @unique
  nameAr      String?    @map("name_ar")
  governorate String?
  country     String     @default("SY")
  isActive    Boolean    @default(true) @map("is_active")
  hospitals   Hospital[]
  users       User[]
  createdAt   DateTime   @default(now()) @map("created_at")

  @@map("cities")
}

model Hospital {
  id        String   @id @default(uuid())
  code      String   @unique // e.g., "DAM-GEN-01"
  name      String
  nameAr    String?  @map("name_ar")
  cityId    String   @map("city_id")
  city      City     @relation(fields: [cityId], references: [id])
  address   String?
  phone     String?
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  departments      Department[]
  doctorProfiles   DoctorProfile[]
  patientProfiles  PatientProfile[]
  doctorSchedules  DoctorSchedule[]
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  medications      Medication[]
  dispensings      Dispensing[]
  labOrders        LabOrder[]
  invoices         Invoice[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  holidays         Holiday[]
  settings         Setting[]
  emergencyVisits  EmergencyVisit[]
  wards            Ward[]
  beds             Bed[]
  admissions       Admission[]
  referralsFrom    Referral[] @relation("ReferralsFrom")
  referralsTo      Referral[] @relation("ReferralsTo")

  @@index([cityId])
  @@map("hospitals")
}

// ─── Phase 4: Inpatient (IPD) ───────────────────────────────────

enum WardType {
  GENERAL
  ICU
  NICU
  POST_OP
  ISOLATION
  MATERNITY
  PEDIATRIC
}

model Ward {
  id           String      @id @default(uuid())
  hospitalId   String      @map("hospital_id")
  hospital     Hospital    @relation(fields: [hospitalId], references: [id])
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  name         String
  type         WardType    @default(GENERAL)
  floor        String?
  description  String?
  isActive     Boolean     @default(true) @map("is_active")
  beds         Bed[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@unique([hospitalId, name])
  @@index([hospitalId])
  @@map("wards")
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

model Bed {
  id         String        @id @default(uuid())
  hospitalId String        @map("hospital_id")
  hospital   Hospital      @relation(fields: [hospitalId], references: [id])
  wardId     String        @map("ward_id")
  ward       Ward          @relation(fields: [wardId], references: [id])
  number     String // bed identifier within the ward (e.g. "A-1", "ICU-03")
  status     BedStatus     @default(AVAILABLE)
  notes      String?
  admissions Admission[] // historical admissions for this bed
  transfersFrom BedTransfer[] @relation("BedTransferFrom")
  transfersTo   BedTransfer[] @relation("BedTransferTo")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@unique([wardId, number])
  @@index([hospitalId])
  @@index([hospitalId, status])
  @@map("beds")
}

enum AdmissionStatus {
  ADMITTED
  TRANSFERRED
  DISCHARGED
  DECEASED
}

model Admission {
  id                String          @id @default(uuid())
  hospitalId        String          @map("hospital_id")
  hospital          Hospital        @relation(fields: [hospitalId], references: [id])
  patientProfileId  String          @map("patient_profile_id")
  patientProfile    PatientProfile  @relation("PatientAdmissions", fields: [patientProfileId], references: [id])
  bedId             String?         @map("bed_id")
  bed               Bed?            @relation(fields: [bedId], references: [id])
  admittingDoctorId String          @map("admitting_doctor_id")
  admittingDoctor   DoctorProfile   @relation("AdmittingDoctor", fields: [admittingDoctorId], references: [id])
  admissionDate     DateTime        @default(now()) @map("admission_date")
  dischargeDate     DateTime?       @map("discharge_date")
  diagnosis         String?
  reason            String?
  status            AdmissionStatus @default(ADMITTED)
  dischargeSummary  String?         @map("discharge_summary")
  transfers         BedTransfer[]
  medicalRecords    MedicalRecord[]
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([hospitalId, status])
  @@index([hospitalId, admissionDate])
  @@index([patientProfileId])
  @@index([bedId])
  @@map("admissions")
}

model BedTransfer {
  id            String    @id @default(uuid())
  admissionId   String    @map("admission_id")
  admission     Admission @relation(fields: [admissionId], references: [id])
  fromBedId     String?   @map("from_bed_id")
  fromBed       Bed?      @relation("BedTransferFrom", fields: [fromBedId], references: [id])
  toBedId       String    @map("to_bed_id")
  toBed         Bed       @relation("BedTransferTo", fields: [toBedId], references: [id])
  transferredAt DateTime  @default(now()) @map("transferred_at")
  reason        String?
  performedById String?   @map("performed_by_id") // User id

  @@index([admissionId])
  @@map("bed_transfers")
}

// ─── Phase 5: Referral (inter-hospital transfer) ────────────────

enum ReferralStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ReferralUrgency {
  ROUTINE
  URGENT
  EMERGENT
}

// Cross-hospital referral. Granting body for canReadCrossHospital:
// a Referral with status IN (ACCEPTED, COMPLETED) gives the receiving
// hospital (toHospitalId) read-only access to the patient's records at
// every hospital they have a PatientProfile at.
// Not tenant-scoped (spans two hospitals). Service layer enforces
// caller visibility via OR: [{fromHospitalId}, {toHospitalId}].
model Referral {
  id                String          @id @default(uuid())
  nationalPatientId String          @map("national_patient_id")
  nationalPatient   NationalPatient @relation(fields: [nationalPatientId], references: [id])
  fromHospitalId    String          @map("from_hospital_id")
  fromHospital      Hospital        @relation("ReferralsFrom", fields: [fromHospitalId], references: [id])
  toHospitalId      String          @map("to_hospital_id")
  toHospital        Hospital        @relation("ReferralsTo", fields: [toHospitalId], references: [id])
  fromDoctorId      String          @map("from_doctor_id") // DoctorProfile of referring doctor
  fromDoctor        DoctorProfile   @relation("ReferralFromDoctor", fields: [fromDoctorId], references: [id])
  toDoctorId        String?         @map("to_doctor_id") // assigned on accept
  toDoctor          DoctorProfile?  @relation("ReferralToDoctor", fields: [toDoctorId], references: [id])
  reason            String
  clinicalSummary   String?         @map("clinical_summary")
  urgency           ReferralUrgency @default(ROUTINE)
  status            ReferralStatus  @default(PENDING)
  respondedAt       DateTime?       @map("responded_at")
  responseNote      String?         @map("response_note")
  completedAt       DateTime?       @map("completed_at")
  cancelledAt       DateTime?       @map("cancelled_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([nationalPatientId])
  @@index([toHospitalId, status])
  @@index([fromHospitalId, status])
  @@map("referrals")
}
